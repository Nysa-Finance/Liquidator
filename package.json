{
  "name": "kamino-usdy-liquidator",
  "version": "0.1.0",
  "description": "Kamino Lend liquidation bot: USDY collateral, USDC debt, atomic flash loan, Orca Whirlpool exit",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "quote": "tsx scripts/quote-orca.ts",
    "fixtures": "node scripts/dump-fixtures.mjs",
    "test": "tsx --test tests/refresh.test.ts tests/flashloan.test.ts tests/swap.test.ts tests/planner.test.ts tests/liquidation.test.ts",
    "test:live": "tsx --test tests/live.readonly.test.ts",
    "test:all": "tsx --test tests/refresh.test.ts tests/flashloan.test.ts tests/swap.test.ts tests/planner.test.ts tests/liquidation.test.ts tests/live.readonly.test.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "report": "tsx scripts/test-report.ts",
    "test:ready": "tsx --test tests/market-ready.test.ts",
    "setup": "tsx --env-file-if-exists=.env scripts/setup-accounts.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.5.1",
    "litesvm": "^1.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "^12.0.0",
    "@orca-so/whirlpools-client": "^5.0.0",
    "@orca-so/whirlpools-core": "^2.0.0",
    "@solana/kit": "^2.3.0",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}

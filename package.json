{
  "name": "kamino-usdy-liquidator",
  "version": "0.1.0",
  "description": "Bot di liquidazione Kamino Lend (USDY collaterale / USDC debito) con flash loan atomico e uscita su Orca Whirlpool",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "inspect": "node scripts/inspect-market.mjs",
    "quote": "tsx scripts/quote-orca.ts",
    "fixtures": "node scripts/dump-fixtures.mjs",
    "test": "tsx --test tests/refresh.test.ts tests/flashloan.test.ts tests/swap.test.ts",
    "test:live": "tsx --test tests/live.readonly.test.ts",
    "test:all": "tsx --test tests/*.test.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.5.1",
    "litesvm": "^1.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "^12.0.0",
    "@orca-so/whirlpools-client": "^5.0.0",
    "@orca-so/whirlpools-core": "^2.0.0",
    "@solana/kit": "^2.3.0",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
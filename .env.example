# --- RPC ------------------------------------------------------------------
# The free public endpoint cannot handle getProgramAccounts on klend: use a real one.
RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=CHANGE_ME
RPC_SECONDARY=https://CHANGE_ME
WS_PRIMARY=wss://mainnet.helius-rpc.com/?api-key=CHANGE_ME

# --- Key ------------------------------------------------------------------
# Path to a JSON file holding the 64-byte keypair array. NEVER inside the repo.
KEYPAIR_PATH=/absolute/path/to/liquidator.json

# --- Safety ---------------------------------------------------------------
# simulate and log, never submit
DRY_RUN=true
# minimum worst-case profit
MIN_PROFIT_USDC=2.0
# minimum profit / repay ratio
MIN_MARGIN_BPS=50
# max |Orca price / Scope price - 1|
MAX_ORACLE_DIVERGENCE_BPS=100
# tolerance on minAcceptableReceivedLiquidityAmount
LIQ_SLIPPAGE_BPS=50
# how stale a snapshot may be before a plan is dropped
MAX_SNAPSHOT_AGE_SLOTS=4
# tolerance on otherAmountThreshold
SWAP_SLIPPAGE_BPS=30
# absolute priority fee cap per transaction
MAX_PRIORITY_LAMPORTS=2000000
# cap relative to expected profit
MAX_PRIORITY_PROFIT_FRACTION=0.25

# --- Lookup table ---------------------------------------------------------
# Printed by `npm run setup -- --confirm`. Without it the transaction serializes
# to ~1509 bytes against a 1232-byte network limit and every send is refused, so
# the bot refuses to start with DRY_RUN=false until it is set.
LOOKUP_TABLE=

# --- Loop -----------------------------------------------------------------
SCAN_INTERVAL_MS=2000
LOG_LEVEL=info

# --- RPC ------------------------------------------------------------------
# The free public endpoint cannot handle getProgramAccounts on klend: use a real one.
RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=CHANGE_ME
RPC_SECONDARY=https://CHANGE_ME
WS_PRIMARY=wss://mainnet.helius-rpc.com/?api-key=CHANGE_ME

# --- Key ------------------------------------------------------------------
# Path to a JSON file holding the 64-byte keypair array. NEVER inside the repo.
KEYPAIR_PATH=/absolute/path/to/liquidator.json

# --- Safety ---------------------------------------------------------------
DRY_RUN=true                       # simulate and log, never submit
MIN_PROFIT_USDC=2.0                # minimum worst-case profit
MIN_MARGIN_BPS=50                  # minimum profit / repay ratio
MAX_ORACLE_DIVERGENCE_BPS=100      # max |Orca price / Scope price - 1|
LIQ_SLIPPAGE_BPS=50                # tolerance on minAcceptableReceivedLiquidityAmount
SWAP_SLIPPAGE_BPS=30               # tolerance on otherAmountThreshold
MAX_PRIORITY_LAMPORTS=2000000      # absolute priority fee cap per transaction
MAX_PRIORITY_PROFIT_FRACTION=0.25  # cap relative to expected profit

# --- Loop -----------------------------------------------------------------
SCAN_INTERVAL_MS=2000
LOG_LEVEL=info

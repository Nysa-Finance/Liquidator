# --- RPC ------------------------------------------------------------------
# Il free endpoint pubblico NON regge getProgramAccounts su klend: usane uno vero.
RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=CHANGE_ME
RPC_SECONDARY=https://CHANGE_ME
WS_PRIMARY=wss://mainnet.helius-rpc.com/?api-key=CHANGE_ME

# --- Chiave ---------------------------------------------------------------
# Path a un file JSON con l'array di 64 byte della keypair. MAI dentro il repo.
KEYPAIR_PATH=/percorso/assoluto/liquidator.json

# --- Sicurezza ------------------------------------------------------------
DRY_RUN=true                       # simula e logga, non invia mai
MIN_PROFIT_USDC=2.0                # profitto worst-case minimo
MIN_MARGIN_BPS=50                  # profitto / repay minimo
MAX_ORACLE_DIVERGENCE_BPS=100      # |prezzo Orca / prezzo Scope - 1| massimo
MAX_SNAPSHOT_AGE_SLOTS=4
LIQ_SLIPPAGE_BPS=50                # tolleranza su minAcceptableReceivedLiquidityAmount
SWAP_SLIPPAGE_BPS=30               # tolleranza su otherAmountThreshold
MAX_PRIORITY_LAMPORTS=2000000      # cap assoluto priority fee per tx
MAX_PRIORITY_PROFIT_FRACTION=0.25  # cap relativo al profitto atteso

# --- Loop -----------------------------------------------------------------
SCAN_INTERVAL_MS=2000
LOG_LEVEL=info

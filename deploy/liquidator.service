# systemd unit for the liquidator. Installed by deploy/install.sh.
#
# Layout on the server:
#   /opt/liquidator/app               the git checkout (built into dist/)
#   /opt/liquidator/.env              settings, mode 600, no inline comments
#   /opt/liquidator/liquidator.json   the hot key, mode 600
#
#   sudo systemctl restart liquidator
#   journalctl -u liquidator -f

[Unit]
Description=Kamino USDY/USDC liquidator
Documentation=https://github.com/Nysa-Finance/Liquidator
After=network-online.target
Wants=network-online.target
# Never stop restarting. The bot already backs off on its own while the RPC is
# failing; a unit that gives up after a few quick deaths stays off until a
# human notices, which is the one outcome a liquidator cannot afford.
StartLimitIntervalSec=0

[Service]
Type=simple
User=liquidator
Group=liquidator
WorkingDirectory=/opt/liquidator/app
EnvironmentFile=/opt/liquidator/.env
Environment=NODE_ENV=production

# The compiled build, made at install time. Building on every start would make
# a broken checkout take the running bot down with it.
ExecStart=/usr/bin/node dist/src/index.js

Restart=always
RestartSec=30
# SIGTERM lets the round in flight finish; the bot exits within a second.
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=liquidator

# It reads its files and talks to the network. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
